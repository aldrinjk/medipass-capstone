# Spring Boot / Supabase PostgreSQL
SUPABASE_DB_URL=jdbc:postgresql://<supabase-session-pooler-host>:5432/postgres?sslmode=require
SUPABASE_DB_USER=<supabase-db-user>
SUPABASE_DB_PASSWORD=<supabase-db-password>

# HAPI FHIR
# Local development: http://localhost:8081/fhir
# Public capstone demo: https://hapi.fhir.org/baseR4
HAPI_FHIR_BASE_URL=http://localhost:8081/fhir

# JWT
JWT_SECRET=replace-with-at-least-32-byte-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Responder verification
# Final public demo uses the Android SMS relay. Keep the shared key server-side
# and enter the same key manually in the relay app at runtime.
RESPONDER_OTP_PROVIDER=android-relay
SMS_RELAY_SHARED_KEY=replace-with-random-secret-at-least-32-characters

# Client-facing API/public URLs
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
RESPONDER_WEB_API_BASE_URL=http://localhost:8080
PUBLIC_RESPONDER_WEB_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# Never place database passwords, JWT secrets, relay keys, or service-role keys
# in EXPO_PUBLIC_* or browser environment variables.
