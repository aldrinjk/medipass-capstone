{
  "expo": {
    "name": "MediPass",
    "slug": "medipass-mobile",
    "scheme": "medipass",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.medipass.patient"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1E40AF"
      },
      "package": "com.medipass.patient",
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "owner": "rockstarvidhu",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "b9f0817f-f810-4cde-a7ba-5d79be4bd3a7"
      }
    }
  }
}
