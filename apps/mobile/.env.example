# Spring Boot API base URL
# Public capstone/demo backend:
EXPO_PUBLIC_API_BASE_URL=https://medipass-api-aldrinjk.onrender.com

# For local development, you can override this with your laptop's API URL.
# Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8080

# Synthetic local data. Keep false unless you explicitly want mocks.
EXPO_PUBLIC_USE_MOCKS=false
