# Spring Boot API base URL
# Simulator / web on the same machine:
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080

# Physical device (Expo Go): localhost is the phone, not your laptop.
# Use your laptop's LAN IP on the same Wi-Fi. Expo tunnel does not forward
# phone requests for localhost:8080 to the API on your computer.
# Example:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.42:8080

# Synthetic local data. Keep false unless you explicitly want mocks.
# Mocks never activate just because the API URL is missing or you are in __DEV__.
EXPO_PUBLIC_USE_MOCKS=false
